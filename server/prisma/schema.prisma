generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Producto {
  id          Int             @id @default(autoincrement())
  nombre      String          @db.NVarChar(100)
  descripcion String          @db.NVarChar(1000)
  precio      Decimal         @db.Decimal(10, 2)
  stock       Int             @default(0)
  categoria   String          @db.NVarChar(50)
  imagen      String          @db.NVarChar(1000)
  etiqueta    String?         @db.NVarChar(50)
  activo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  detalles    PedidoDetalle[]
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.NVarChar(254)
  passwordHash String   @db.NVarChar(255)
  role         String   @default("user") @db.NVarChar(10)
  createdAt    DateTime @default(now())
  pedidos      Pedido[]
}

model Pedido {
  id        Int             @id @default(autoincrement())
  userId    Int
  total     Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now())
  usuario   Usuario         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detalles  PedidoDetalle[]
}

model PedidoDetalle {
  id             Int      @id @default(autoincrement())
  pedidoId       Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([pedidoId, productoId])
}
